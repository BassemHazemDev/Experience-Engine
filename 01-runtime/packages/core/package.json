{
  "name": "@experience-engine/core",
  "version": "0.1.0",
  "description": "Framework-agnostic runtime for multi-dimensional UI experience transitions across culture, theme and motion.",
  "keywords": [
    "ui",
    "runtime",
    "i18n",
    "rtl",
    "theming",
    "design-tokens",
    "localization",
    "transitions",
    "adaptive-ui",
    "experience"
  ],
  "license": "MIT",
  "author": "Bassem Hazem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BassemHazemDev/Experience-Engine.git",
    "directory": "01-runtime/packages/core"
  },
  "homepage": "https://github.com/BassemHazemDev/Experience-Engine#readme",
  "bugs": {
    "url": "https://github.com/BassemHazemDev/Experience-Engine/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
