{
  "name": "@experience-engine/react",
  "version": "0.1.0",
  "description": "React adapter for Experience Engine: provider and hooks built on useSyncExternalStore.",
  "keywords": [
    "react",
    "hooks",
    "i18n",
    "rtl",
    "theming",
    "design-tokens",
    "experience-engine",
    "ssr"
  ],
  "license": "MIT",
  "author": "Bassem Hazem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BassemHazemDev/Experience-Engine.git",
    "directory": "01-runtime/packages/react"
  },
  "homepage": "https://github.com/BassemHazemDev/Experience-Engine#readme",
  "bugs": {
    "url": "https://github.com/BassemHazemDev/Experience-Engine/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@experience-engine/core": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
